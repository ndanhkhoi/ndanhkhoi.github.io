{
  "name": "ndanhkhoi.github.io",
  "private": true,
  "version": "1.0.0",
  "description": "Personal CV - modern web resume (Astro) + print-first A4 document printed to cv.pdf",
  "scripts": {
    "dev": "npm run assets && astro dev",
    "assets": "node scripts/prepare-assets.mjs",
    "build": "npm run build:html && npm run build:pdf",
    "build:html": "npm run assets && astro build",
    "build:pdf": "node scripts/build-pdf.mjs",
    "check": "astro check",
    "check:view": "python3 scripts/check_view.py",
    "preview": "astro preview"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagedjs": "^0.4.3",
    "pdfjs-dist": "^6.3.289",
    "puppeteer": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.3.2"
  },
  "type": "module"
}
