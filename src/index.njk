<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ resume.meta.name }} - CV">
  <title>{{ resume.meta.name }} - CV</title>
  <!-- No webfont here: the CV's own type is baked into cv.pdf, and the only text
       this page sets is the toolbar. The no-JS branch below loads Inter, because
       there the browser really is typesetting the CV. -->
  <link rel="stylesheet" href="/vendor/pdfjs/pdf_viewer.css">
  <link rel="stylesheet" href="/css/viewer.css">
  <noscript><style>#pv-status { display: none; }</style></noscript>
</head>
<body data-pdf-name="{{ resume.meta.name | slug }}-cv.pdf">

<header class="pv-toolbar" role="toolbar" aria-label="PDF viewer">
  <div class="pv-toolbar__group">
    <button type="button" id="previous" class="pv-btn" title="Previous page" aria-label="Previous page">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
    </button>
    <button type="button" id="next" class="pv-btn" title="Next page" aria-label="Next page">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <span class="pv-pages">
      <input type="number" id="pageNumber" class="pv-pageinput" value="1" min="1" step="1"
             aria-label="Page number" autocomplete="off">
      <span id="numPages" class="pv-pagetotal"></span>
    </span>
  </div>

  <div class="pv-toolbar__group pv-toolbar__group--zoom">
    <button type="button" id="zoomOut" class="pv-btn" title="Zoom out" aria-label="Zoom out">
      <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </button>
    <button type="button" id="zoomIn" class="pv-btn" title="Zoom in" aria-label="Zoom in">
      <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><line x1="12" y1="5" x2="12" y2="19"/></svg>
    </button>
    <select id="zoomSelect" class="pv-select" aria-label="Zoom level">
      <option value="auto">Automatic</option>
      <option value="page-actual">Actual size</option>
      <option value="page-fit">Page fit</option>
      <option value="page-width">Page width</option>
      <option value="0.5">50%</option>
      <option value="0.75">75%</option>
      <option value="1">100%</option>
      <option value="1.25">125%</option>
      <option value="1.5">150%</option>
      <option value="2">200%</option>
      <option value="custom" hidden></option>
    </select>
  </div>

  <div class="pv-toolbar__group pv-toolbar__group--end">
    <button type="button" id="print" class="pv-btn" title="Print" aria-label="Print">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
    </button>
    <a id="download" class="pv-btn" href="/cv.pdf" title="Download" aria-label="Download">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
    </a>
  </div>
</header>

<div id="viewerContainer" class="pv-container">
  <div id="viewer" class="pdfViewer"></div>
</div>

<div id="pv-status" class="pv-status"><div class="pv-spinner"></div></div>

<!-- The CV text, for crawlers and for anyone without JS. Same content as the
     PDF above (both come from src/_includes/cv-document.njk), so the page is
     never an empty canvas to a reader that cannot run pdf.js. -->
<noscript>
  <link rel="stylesheet" href="/fonts/inter.css">
  <link rel="stylesheet" href="/css/resume.css">
  <style>
    .pv-toolbar, .pv-container { display: none; }
    html, body { background: #ececec; }
    body { padding: 10mm 0; }
    .page { min-height: 297mm; margin: 0 auto 10mm; border: 0.5pt solid #c8c8c8;
            box-shadow: 0 1mm 5mm rgba(0, 0, 0, 0.16); }
  </style>
  {% include "cv-document.njk" %}
</noscript>

<script type="module" src="/js/viewer.js"></script>
<script>
  /* The viewer module may never run (blocked, 404, unsupported browser).
     Without this the homepage would spin forever with the CV one click away. */
  setTimeout(function () {
    var status = document.getElementById("pv-status");
    if (!status || document.documentElement.dataset.pvReady) return;
    status.textContent = "";
    var p = document.createElement("p");
    p.textContent = "The CV viewer did not load.";
    var a = document.createElement("a");
    a.href = "/print.html";
    a.textContent = "Open the HTML version instead";
    status.appendChild(p);
    status.appendChild(a);
  }, 12000);
</script>
</body>
</html>
