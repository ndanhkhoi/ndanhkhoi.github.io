---
/* Fixed header: quiet at the top of the page, then a solid bar carrying the
   name, the section nav and the PDF once anything scrolls under it.

   The stuck state, the reading-progress line and the aria-current on the links
   are all set by src/scripts/site.ts; with no JS this is still a working set of
   anchor links and a link to the PDF, which is the point. */
import resume from "../../data/resume.js";
import { sections } from "../../lib/sections";
import { titleCase } from "../../lib/text";
import Icon from "./Icon.astro";

const displayName = titleCase(resume.meta.name);
---
<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <a class="brand" href="#top">{displayName}</a>

    <nav class="site-nav" aria-label="Sections">
      <ul class="site-nav__list">
        {sections.map((s) => (
          <li><a class="site-nav__link" href={`#${s.id}`} data-nav-for={s.id}>{s.nav}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button
        type="button"
        class="btn btn--icon theme-toggle"
        id="theme-toggle"
        aria-label="Switch colour theme"
      >
        <Icon name="moon" class="theme-toggle__icon theme-toggle__icon--moon" />
        <Icon name="sun" class="theme-toggle__icon theme-toggle__icon--sun" />
      </button>

      <a class="btn btn--quiet" id="open-pdf" href="/cv.pdf" target="_blank" rel="noopener">
        <Icon name="file" />
        <span>CV</span>
      </a>

      {/* Narrow screens have no room for the section list, so it moves behind
          this button. Rendered `hidden`: src/scripts/site.ts unhides it once it
          has wired up the panel, so a visitor with no JS is never shown a
          button that cannot open anything. */}
      <button
        type="button"
        class="btn btn--icon nav-toggle"
        id="nav-toggle"
        aria-label="Sections"
        aria-expanded="false"
        aria-controls="mobile-nav"
        hidden
      >
        <Icon name="menu" class="nav-toggle__icon nav-toggle__icon--menu" />
        <Icon name="close" class="nav-toggle__icon nav-toggle__icon--close" />
      </button>
    </div>
  </div>

  {/* The same links as .site-nav, in the same order, from the same list - this
      is a second presentation of the nav, not a second nav. */}
  <nav class="mobile-nav" id="mobile-nav" aria-label="Sections" hidden>
    <ul class="mobile-nav__list">
      {sections.map((s) => (
        <li><a class="mobile-nav__link" href={`#${s.id}`} data-nav-for={s.id}>{s.nav}</a></li>
      ))}
    </ul>
  </nav>

  <div class="progress" id="progress" aria-hidden="true"></div>
</header>
