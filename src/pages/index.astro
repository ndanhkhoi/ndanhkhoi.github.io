---
/* / - the web resume.
 *
 * Server-rendered from src/data/resume.js, the same file /print.html and
 * therefore cv.pdf are built from. No client framework: the only JavaScript
 * the page ships is src/scripts/site.ts, and everything it does is optional.
 */
import resume from "../data/resume.js";
import { autolink } from "../lib/autolink";
import { sectionById } from "../lib/sections";
import SiteHeader from "../components/web/SiteHeader.astro";
import SiteFooter from "../components/web/SiteFooter.astro";
import Hero from "../components/web/Hero.astro";
import Section from "../components/web/Section.astro";
import Bullets from "../components/web/Bullets.astro";
import Icon from "../components/web/Icon.astro";
import "../styles/site.css";

const { meta, web } = resume;
const title = `${meta.name} - ${meta.jobTitle}`;
const description = resume.summary || `${meta.name} - CV`;
const mail = meta.contacts.find((c) => c.icon === "mail");

/* Some skill groups are keyword lists ("Java", "Redis"), others are whole
   sentences. Chips suit the first and mangle the second, so the shape of the
   data picks the rendering. */
const isKeywordList = (items: string[]) => items.every((i) => i.length <= 34);

/* Structured data: a recruiter's tooling (and Google) reads this before it
   reads the layout. Same facts as the page, in the format they expect. */
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: meta.name,
  jobTitle: meta.jobTitle,
  description: resume.summary,
  url: "https://ndanhkhoi.github.io/",
  email: mail?.href?.replace(/^mailto:/, ""),
  address: meta.contacts.find((c) => c.icon === "location")?.text,
  sameAs: web.links.map((l) => l.href),
  worksFor: resume.experience[0] ? { "@type": "Organization", name: resume.experience[0].company } : undefined,
  alumniOf: resume.education[0]
    ? { "@type": "EducationalOrganization", name: resume.education[0].school }
    : undefined,
  knowsAbout: resume.skills.flatMap((s) => s.items).filter((i) => i.length <= 34),
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f6f8fc" />
  <link rel="canonical" href="https://ndanhkhoi.github.io/" />

  <meta property="og:type" content="profile" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://ndanhkhoi.github.io/" />
  <meta name="twitter:card" content="summary" />

  <link rel="stylesheet" href="/fonts/inter.css" />

  {/* Before first paint, so the page never flashes the wrong theme and the
      reveal animations never flash their finished state.

      The timer is the safety net for the animation flag: if site.ts is blocked,
      404s or throws before it claims the page, the start state (opacity: 0)
      would otherwise hide the CV for good. */}
  <script is:inline>
    (function () {
      var el = document.documentElement;
      try {
        var saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") el.dataset.theme = saved;
      } catch (e) { /* private mode */ }

      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        el.dataset.anim = "on";
        setTimeout(function () {
          if (!el.dataset.animReady) el.removeAttribute("data-anim");
        }, 2500);
      }
    })();
  </script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="backdrop" aria-hidden="true">
    <div class="backdrop__glow backdrop__glow--a"></div>
    <div class="backdrop__glow backdrop__glow--b"></div>
  </div>

  <SiteHeader />

  <main id="main">
    <Hero />

    {resume.summary && (
      <Section meta={sectionById("about")}>
        <p class="lead reveal" style="--i: 0" set:html={autolink(resume.summary)} />
      </Section>
    )}

    {resume.experience.length > 0 && (
      <Section meta={sectionById("experience")}>
        <div class="timeline">
          {resume.experience.map((e, i) => (
            <article class="timeline__item card card--lift card--glow reveal" style={`--i: ${i}`}>
              <div class="entry-head">
                <h3 class="entry-title">
                  {e.position} <span class="entry-org">· {[e.company, e.location].filter(Boolean).join(" · ")}</span>
                </h3>
                <span class="entry-period">{e.period}</span>
              </div>
              <Bullets items={e.highlights} />
            </article>
          ))}
        </div>
      </Section>
    )}

    {resume.projects.length > 0 && (
      <Section meta={sectionById("projects")}>
        <div class="projects">
          {resume.projects.map((p, i) => (
            <article class="card card--lift card--glow reveal" style={`--i: ${i}`}>
              <h3 class="entry-title">{p.name}</h3>
              {/* Role and dates share one meta line: in a grid column this
                  narrow, a period pushed to the right edge just wraps. */}
              <p class="entry-meta">
                {p.role && <span class="project__role">{p.role}</span>}
                <span class="entry-period">{p.period}</span>
              </p>
              <Bullets items={p.highlights} />
              {p.link && (
                <a class="project__link" href={p.link} target="_blank" rel="noopener">
                  <span>{p.link.replace(/^https?:\/\//, "").replace(/\/$/, "")}</span>
                  <Icon name="external" />
                </a>
              )}
            </article>
          ))}
        </div>
      </Section>
    )}

    {resume.skills.length > 0 && (
      <Section meta={sectionById("skills")}>
        <div class="skills">
          {resume.skills.map((s, i) => (
            <article class="card card--lift reveal" style={`--i: ${i}`}>
              <h3 class="skill__label">{s.label}</h3>
              {isKeywordList(s.items) ? (
                <ul class="tags">
                  {s.items.map((item) => <li class="tag">{item}</li>)}
                </ul>
              ) : (
                <ul class="bullets">
                  {s.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </Section>
    )}

    {resume.writing.length > 0 && (
      <Section meta={sectionById("writing")}>
        <div class="projects">
          {resume.writing.map((w, i) => (
            <article class="card card--lift card--glow reveal" style={`--i: ${i}`}>
              <h3 class="entry-title">{w.title}</h3>
              <Bullets items={w.highlights} />
            </article>
          ))}
        </div>
      </Section>
    )}

    {resume.awards.length > 0 && (
      <Section meta={sectionById("awards")}>
        <ul class="awards">
          {resume.awards.map((a, i) => (
            <li class="award card card--lift reveal" style={`--i: ${i}`}>
              <span class="award__badge" aria-hidden="true"><Icon name="award" /></span>
              <span class="award__name">{a.name}</span>
              {a.extra && <span class="award__year">{a.extra}</span>}
            </li>
          ))}
        </ul>
      </Section>
    )}

    {resume.education.length > 0 && (
      <Section meta={sectionById("education")}>
        <div class="timeline">
          {resume.education.map((ed, i) => (
            <article class="timeline__item card card--lift reveal" style={`--i: ${i}`}>
              <div class="entry-head">
                <h3 class="entry-title">
                  {ed.degree || ed.school}
                  {ed.degree && ed.school && <span class="entry-org"> · {ed.school}</span>}
                </h3>
                <span class="entry-period">{ed.period}</span>
              </div>
              {ed.detail && <p class="entry-note" set:html={autolink(ed.detail)} />}
            </article>
          ))}
        </div>
      </Section>
    )}
  </main>

  <SiteFooter />

  <script>
    import "../scripts/site.ts";
  </script>
</body>
</html>
